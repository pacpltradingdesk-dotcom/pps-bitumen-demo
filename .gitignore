# Live AIS vessel snapshot (written by ais_collector daemon at runtime)
tbl_live_vessels.json

# Port-page vessel arrivals (written by port_scraper cron at runtime)
tbl_port_arrivals.json

# Daily KPI %-change reference (written by pps-price-snapshot cron at runtime).
# Tracking it made every deploy (git pull/stash) revert it to a stale committed
# fossil, producing a bogus "USD/INR ▼7.4%" daily move. Untracked so the
# server's fresh daily write persists across deploys.
tbl_price_history_snapshot.json

# Runtime price overrides written by the Update-from-Circular flow + manual
# price entry (VG30 base, per-location prices, grade premiums). Must persist on
# the server across deploys — tracking it meant each deploy could revert applied
# circular prices. All keys fall back to price_master defaults when absent.
live_prices.json

