# deploy/pps-ais-collector.service
[Unit]
Description=PPS Anantam AIS collector (AISStream -> tbl_live_vessels.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pps-bitumen
# Set the key here OR in an EnvironmentFile. Replace REPLACE_WITH_KEY.
Environment=AISSTREAM_API_KEY=REPLACE_WITH_KEY
# ExecStart python path is set during deploy to the app's venv (see setup doc).
ExecStart=/opt/pps-bitumen/venv/bin/python /opt/pps-bitumen/ais_collector.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
